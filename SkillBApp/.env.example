# Copy to SkillBApp/.env — never commit real secrets
# Expo exposes only EXPO_PUBLIC_* to the app bundle (publishable keys only)

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe publishable key (pk_test_... for testing, pk_live_... for production)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Deployed payment API. Must be HTTPS in production. Must end with /api/payments
# Example: https://skillbridge-payment.up.railway.app/api/payments
EXPO_PUBLIC_PAYMENT_API_URL=http://localhost:3001/api/payments
