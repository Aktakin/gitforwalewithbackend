# Copy this file to .env and fill in values.
# Stripe test keys: https://dashboard.stripe.com/test/apikeys

REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Required for real card UI (pk_test_...). If missing, the app uses mock payments.
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Optional locally — dev server uses package.json "proxy" to :3001 (see stripeService getPaymentApiBase).
# For production builds, set your deployed API, e.g. REACT_APP_PAYMENT_API_URL=https://api.example.com/api/payments
# REACT_APP_PAYMENT_API_URL=http://localhost:3001/api/payments
