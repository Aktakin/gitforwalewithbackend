# Copy to server/.env (or set in root .env — payment-api loads both).
# Secret key: https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_your_secret_key
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: lock CORS to ALLOWED_ORIGINS + defaults (for production behind a known frontend URL)
# STRIPE_CORS_STRICT=1
